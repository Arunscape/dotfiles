#!/sbin/openrc-run

description="Arun's $RC_SVCNAME instance with podman"
run_path="${XDG_RUNTIME_DIR}/podman"
log_path="${run_path}/log"
pidfile="${run_path}/${RC_SVCNAME}.pid"
output_log="${log_path}/${RC_SVCNAME}.log"
error_log=$output_log
command=podman
command_args_foreground="run
              --name $RC_SVCNAME
              --userns=keep-id:uid=1000,gid=1000
              -p $web_port:7070
              -p $http_proxy_port:4444
              -p $https_proxy_port:4445
              -p $socks_proxy_port:4447
              -p $sam_port:7656
              -p $transport_port:4567
              -p $transport_port:4567/udp
              -v $data_path:/home/i2pd/data
              --replace
              --network $network
              $container_url
             "
command_background=true
supervisor=supervise-daemon

depend() {
    use podman
}

start_pre(){
  checkpath -o $USER -d "${run_path}" "${log_path}"

  ebegin "Checking $data_path"
  checkpath -o $USER -d "${data_path}"
  eend $? "Double check $data_path"

  ebegin "Checking network $network"
  if ! podman network exists "$network"; then
    podman network create "$network" --ipv6
  fi
  eend $? "Failed to check or create network $network"

  ebegin "Pulling $container_url"
  podman pull $container_url
  eend $? "Failed to pull $container_url"
}

stop_post(){
  ebegin "Stopping $RC_SVCNAME"
  podman stop $RC_SVCNAME
  eend $? "Failed to stop $RC_SVCNAME"
}
