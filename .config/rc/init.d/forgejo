#!/sbin/openrc-run

description="Arun's $RC_SVCNAME instance with podman"
run_path="${XDG_RUNTIME_DIR}/podman"
log_path="${run_path}/log"
pidfile="${run_path}/${RC_SVCNAME}.pid"
output_log="${log_path}/${RC_SVCNAME}.log"
error_log=$output_log
command=podman
command_args_foreground="run
              --name $RC_SVCNAME
              -p $web_port:3000
              -p $ssh_port:2222
              -v $data_path:/var/lib/gitea:U
              -v $conf_path:/etc/gitea:U
              --userns keep-id
              --cgroup-manager cgroupfs
              --replace
              --network $network
              $container_url
             "
command_background=true
supervisor=supervise-daemon
supervise_daemon_args="--env XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR} --env HOME=${HOME} --env USER=${USER}"

depend() {
    use podman
}

start_pre(){
  checkpath -o $USER -d "${run_path}" "${log_path}"

  ebegin "Checking $data_path and $conf_path"
  checkpath -o $USER -d "${data_path}" "${conf_path}"
  eend $? "Double check $data_path and $conf_path"

  if [ -n "$network" ]; then
    ebegin "Checking for podman network $network"
    if ! podman network exists $network >/dev/null 2>&1; then
        einfo "Creating podman network $network"
        podman network create $network >/dev/null
    fi
    eend $? "Failed to check/create network"
  fi

  ebegin "Pulling $container_url"
  podman pull $container_url
  eend $? "Failed to pull $container_url"
}

stop_post(){
  ebegin "Stopping $RC_SVCNAME"
  podman stop $RC_SVCNAME
  eend $? "Failed to stop $RC_SVCNAME"
}
